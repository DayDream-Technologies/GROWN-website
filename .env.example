# =============================================================================
# Frontend (Vite) — set in CI / AWS Amplify / CodeBuild before `vite build`
# =============================================================================
# Host root URL path for assets & routing: `/` for Amplify (default build); `/repo-name/` for GitHub Pages project sites.
# VITE_BASE=/

# Production: absolute origin of your deployed Square BFF (HTTPS, no trailing slash).
# Never use localhost or private IPs here — they get baked into the JS and trigger browser "local network" prompts.
# Local dev: leave unset so the app uses `/api` and Vite proxies to SQUARE_BFF_PROXY_TARGET.
# VITE_BFF_ORIGIN=https://bff.yourdomain.com

# Optional: override header mark (default: site/ghf-secondary-green.svg from brand kit).
# VITE_HEADER_LOGO=site/ghf-secondary-black.svg

# Square Application ID (public; embedded in the browser bundle). Default in code matches production app.
# VITE_SQUARE_APPLICATION_ID=sq0idp-pnD1Ri5un2ZCGgtq9bzq5Q

# Optional — shown on contact and inquiry UI.
# VITE_CONTACT_EMAIL=hello@yourdomain.com

# =============================================================================
# Square BFF (Node in `server/`) — runtime env on Lambda, ECS, EC2, etc.
# =============================================================================
# Store in AWS Secrets Manager (or SSM SecureString); inject into task / function env.
SQUARE_ACCESS_TOKEN=EAAA-your-square-access-token

# `production` → https://connect.squareup.com | `sandbox` → sandbox API host
SQUARE_ENVIRONMENT=production

# Square Dashboard → Locations
SQUARE_LOCATION_ID=YOUR_LOCATION_ID

# Optional duplicate of app id for server-side use if you extend the BFF later.
SQUARE_APPLICATION_ID=sq0idp-pnD1Ri5un2ZCGgtq9bzq5Q

# =============================================================================
# Local dev only
# =============================================================================
# Vite `npm run dev` proxies `/api` here when VITE_BFF_ORIGIN is unset.
# SQUARE_BFF_PROXY_TARGET=http://127.0.0.1:8787

PORT=8787
