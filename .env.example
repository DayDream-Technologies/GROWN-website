# =============================================================================
# Frontend (Vite) — set in CI / AWS Amplify / CodeBuild before `vite build`
# =============================================================================
# Host root URL path for assets & routing: `/` for Amplify (default build); `/repo-name/` for GitHub Pages project sites.
# VITE_BASE=/

# Optional: override header mark (default: site/ghf-secondary-green.svg from brand kit).
# VITE_HEADER_LOGO=site/ghf-secondary-black.svg

# Optional — shown on contact, inquiry UI, and cart checkout email.
# VITE_CONTACT_EMAIL=hello@yourdomain.com
