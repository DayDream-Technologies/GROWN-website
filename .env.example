# =============================================================================
# Frontend (Vite) — set in CI / AWS Amplify / CodeBuild before `vite build`
# =============================================================================
# Host root URL path for assets & routing: `/` for Amplify (default build); `/repo-name/` for GitHub Pages project sites.
# VITE_BASE=/

# Optional: override header mark (default: brand/GHF_Black.svg from brand kit).
# VITE_HEADER_LOGO=brand/ghf-secondary-green.svg

# Optional: override home hero mark over carousel (default: brand/GHF_Secondary_Black(OnlyG).svg).
# VITE_HERO_LOGO=brand/ghf-secondary-green.svg

# Optional — overrides default inbound address (danelle@grownhydroponicfarms.com) on contact, shop banner, inquiries, cart email.
# VITE_CONTACT_EMAIL=you@example.com

# Web3Forms — contact form submissions (https://web3forms.com). Required for the contact page form.
# VITE_WEB3FORMS_ACCESS_KEY=

# -----------------------------------------------------------------------------
# Stripe (browser-safe publishable key only — secret key stays on AWS Lambda)
# -----------------------------------------------------------------------------
# Publishable key from Stripe Dashboard (pk_test_... / pk_live_...).
# VITE_STRIPE_PUBLISHABLE_KEY=

# AWS API Gateway base URL from SAM stack Output HttpApiUrl (no trailing slash).
# VITE_CHECKOUT_API_URL=https://xxxxxxxx.execute-api.us-east-1.amazonaws.com

# -----------------------------------------------------------------------------
# AWS Lambda deploy (sam deploy — set in console or parameters file; never commit)
# -----------------------------------------------------------------------------
# StripeSecretKey=sk_test_...
# StripeWebhookSecret=whsec_...
# SiteUrl=https://your-branch.amplifyapp.com   # no trailing slash; include path prefix if using GitHub Pages-style base
# AllowedOrigin=https://your-branch.amplifyapp.com

# After deploy: paste Stripe Price IDs into infra/checkout-session/stripe-catalog.json, redeploy checkout Lambda (or rebuild).

# Stripe webhook endpoint URL = {HttpApiUrl}/webhooks/stripe — register in Stripe Dashboard; subscribe to checkout.session.completed (and subscription events as needed).
